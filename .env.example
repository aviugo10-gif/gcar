# Supabase (new project). Public values:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Encrypts customer ID numbers on the server (separate from the vault).
ID_NUMBER_KEY=
# 32 random bytes, base64. HMAC for searching ID numbers.
ID_NUMBER_HMAC_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://gcar.example
NEXT_PUBLIC_BUSINESS_PHONE=0528528282

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=gcar <noreply@gcar.example>
NOTIFY_EMAIL_TO=

# OCR: "mock" until a Gemini key exists, then "gemini"
OCR_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
